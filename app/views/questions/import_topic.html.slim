.container
  = form_tag import_questions_path, multipart: true do
    .row.mt-3
      .custom-file data-controller="file-input-label"
        = file_field_tag :file, id: 'select-file', class: 'custom-file-input', data: { file_input_label_target: 'input', action: 'change->file-input-label#update' }
        label for='select-file' class='custom-file-label' data-file-input-label-target='label' Choose File
      = hidden_field_tag :topic_id, @topic.id
    .row.my-2
      .col
        = submit_tag "Import", class: 'btn w-100 btn-primary'
