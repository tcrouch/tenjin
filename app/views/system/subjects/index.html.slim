.container
  .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.pt-4.mb-3
    h1.display-4.mb-0 Subjects
    - if current_admin.super?
      = link_to 'Add Subject', new_system_subject_path, class: 'btn btn-primary'
  .table-responsive
    table.table#active-subjects
      tr
        th Name
        th Questions Available
        th Questions Asked Overall
        th Questions Asked This Week

      - @subjects.each do |subject|
        tr id=('subject-' + subject.id.to_s)
          td.name = link_to(subject.name, edit_system_subject_path(subject))
          td.questionsAvailable = @question_counts[subject.id].to_i
          td.asked_questions = @subject_statistics[subject.id].asked_questions
          td.asked_questions_this_week = @subject_statistics[subject.id].asked_questions_this_week
  - if current_admin.super?
    h2.display-4.my-5 Deactivated Subjects
    .table-responsive
      table.table#deactivated-subjects
        tr
          th Name
          th Questions Available

        - @deactivated_subjects.each do |subject|
          tr id=('subject-' + subject.id.to_s)
            td.name = link_to(subject.name, edit_system_subject_path(subject))
            td.questionsAvailable = @question_counts[subject.id].to_i
