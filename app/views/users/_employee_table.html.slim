h1.page-section-header.text-uppercase Employees
hr.small.mb-5.primary-red
.col.table-responsive data-controller='datatable' data-datatable-options-value=({ paging: true, dom: "<'row'<'col-sm-12 col-md-4 pt-4'B><'col-sm-12 col-md-4'l><'col-sm-12 col-md-4'f>><'row'<'col-sm-12'tr>><'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>", buttons: ['copyHtml5', 'csvHtml5', 'excelHtml5'] }.to_json)
  table.table#employees-table data-datatable-target='table'
    thead
      tr
        th Name
        th Username
        th.d-none.d-lg-block Classes
        th Reset Password?
    tbody
      - @employees.each do |e|
        tr.employee-row data-id=e.id
          td
            => e.forename
            = e.surname
          td = e.username
          td.d-none.d-lg-block = user_class_names(e)
          td =link_to('Reset Password', reset_password_user_path(id: e.id), class: 'btn btn-dark reset-password reset-password-student', data: { controller: 'password-reset', action: 'click->password-reset#reset' })
