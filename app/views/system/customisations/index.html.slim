.container
  = admin_page_header 'Customisations' do
    = link_to 'Add Customisation', new_system_customisation_path, class: 'btn btn-primary'
section.available-customisations aria-labelledby='available-heading'
  .container
    h2.admin-section-heading#available-heading Available
  = render partial: "customisations/customisations",
    locals: { customisations: @customisations.order(sticky: :desc, purchasable: :desc),
      bought_customisations: [], manage: true }
section.retired-customisations aria-labelledby='retired-heading'
  .container
    h2.admin-section-heading#retired-heading Retired
  = render partial: "customisations/customisations",
    locals: {customisations: @retired_customisations, bought_customisations: [], manage: true}
