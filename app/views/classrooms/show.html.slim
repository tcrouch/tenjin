-content_for :title
  title=('Classroom - ' + @classroom.name)
.container
  h1.h1.mt-3.text-center =@classroom.name
  section.page-section.text-center.pt-2#homework
    h1.page-section-header.text-uppercase Homework
    hr class=("small mb-5 primary-red")
    .row.justify-content-center
      =link_to 'Set Homework', new_homework_path(classroom: {classroom_id: @classroom.id}), class: 'btn btn-block btn-primary'
      .col.mx-auto data-controller='datatable' data-datatable-options-value=({ dom: 'rtp', pageLength: 5, order: [[2, 'desc']], language: { emptyTable: 'No homeworks have been found' } }.to_json)
        table.table.table-hover#homework-table data-datatable-target='table'
          thead
            tr
              th Topic
              th Completion
              th Due
          tbody
            -@homeworks.each do |h|
              tr.homework-data data-controller='row-link' data-row-link-url-value=homework_path(h) data-action='click->row-link#navigate' data-id=h.id
                td =h.topic.name
                td =report_progress(h)
                td =h.due_date.strftime("%d/%m/%y %H:%M")
  section.page-section.text-center.pt-2#students data-controller='password-col-toggle'
    h1.page-section-header.text-uppercase Students
    hr class=("small mb-5 primary-red")
    .row.justify-content-center
      .form-check.form-check-inline
        input.form-check-input#resetPasswordCheck type='checkbox' data-action='change->password-col-toggle#toggle'
        label.form-check-label for='resetPasswordCheck' Reset Passwords?
    .row.justify-content-center data-controller='datatable' data-datatable-options-value=({ paging: false, dom: '<"row align-items-center"<"col d-flex "B><"col"fr>><"row"t>', buttons: ['copyHtml5', 'csvHtml5', 'excelHtml5'] }.to_json)
      table.table#students-table style="width:100%" data-datatable-target='table'
        thead
          tr
            th First Name
            th Last Name
            th Username
            th.password-col.d-none data-password-col-toggle-target='col' Reset Password
            th Homeworks
        tbody
          -@students.each do |s|
            tr.student-data data-controller='row-link' data-row-link-url-value=user_path(s) data-action='click->row-link#navigate' data-id=s.id
              td =s.forename
              td =s.surname
              td =s.username
              td.password-col.d-none data-password-col-toggle-target='col'
                =link_to('Reset Password', reset_password_user_path(id: s.id), class: 'btn btn-dark reset-password reset-password-student', data: { controller: 'password-reset', action: 'click->password-reset#reset' })
              td =link_to(s) do
                ==student_homeworks(s, @homework_progress)
