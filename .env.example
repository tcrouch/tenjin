# Copy to .env for local development. dotenv loads .env in development and
# test (.env.test overrides it for specs); production sets Heroku config vars.

# Database
# Local connections use config/database.yml plus libpq's PG* variables.
# Never set DATABASE_URL here: it overrides the test database too, and specs
# would truncate whatever it points at.
# PGHOST=localhost
# PGUSER=postgres
# PGPASSWORD=
# DATABASE_URL: production only, set by Heroku Postgres
# RAILS_MAX_THREADS: Puma threads per worker and the Active Record pool size (default 3)
# RAILS_MAX_THREADS=3

# Email
# DEFAULT_MAIL_SENDER: From address for every mailer, Devise's included
DEFAULT_MAIL_SENDER="Tenjin <no-reply@outwood.com>"
# EMAIL_RECIPIENTS: development only; comma-separated addresses that receive all
# outgoing mail. Unset leaves dev mail with no recipient, so it is dropped
EMAIL_RECIPIENTS=your.email@outwood.com

# AWS
# Read directly by the AWS SDK. Mail goes through SES outside test, so sending
# mail in development needs these too
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
# AWS_S3_BUCKET: production only; development stores uploads on disk in storage/
# AWS_S3_BUCKET=

# Wonde SSO (Sign in with Wonde)
# Roster sync tokens are per school, stored on School#token, not here
WONDE_CLIENT_ID=
WONDE_SECRET=
# WONDE_CALLBACK_URL: optional; defaults to the requesting host's
# /users/auth/wonde/callback, which must be registered with Wonde
# WONDE_CALLBACK_URL=http://localhost:3000/users/auth/wonde/callback

# Wonde test school, for `bin/rails dev:bootstrap_wonde`
# WONDE_TEST_SCHOOL_ID: Wonde school ID; the School must already exist with this client_id
WONDE_TEST_SCHOOL_ID=
WONDE_TEST_TOKEN=
# debug_wonde: any value prints raw Wonde API responses
# debug_wonde=1

# Google OAuth (Sign in with Google)
# Authorised redirect URI: http://localhost:3000/users/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Hosts
# DEFAULT_HOST: production only; host for links in emails (development uses localhost:PORT)
# DEFAULT_HOST=tenjin.outwood.com
# ASSET_HOST: origin for images and assets referenced in emails
# ASSET_HOST=https://tenjin.outwood.com
# CORS_ORIGINS: comma-separated origins allowed to fetch /assets and /packs
# CORS_ORIGINS=https://tenjin.outwood.com

# Branding and analytics
# OGAT: any value shows the Outwood Grange Academies Trust About page
# OGAT=true
# GOOGLE_ANALYTICS_ID: production only; the tag is not rendered elsewhere
# GOOGLE_ANALYTICS_ID=

# Server
# PORT: Puma port, also used in development mailer links (default 3000)
# PORT=3000
# WEB_CONCURRENCY: Puma worker processes (default 2)
# WEB_CONCURRENCY=2
# PIDFILE: optional Puma PID file path
# PIDFILE=

# Production platform
# SECRET_KEY_BASE: production only; development and test generate tmp/local_secret.txt
# SECRET_KEY_BASE=
# RAILS_SERVE_STATIC_FILES: any value serves public/ from Rails (Heroku has no nginx)
# RAILS_SERVE_STATIC_FILES=enabled
# RAILS_LOG_LEVEL: default info
# RAILS_LOG_LEVEL=info
# RACK_TIMEOUT_SERVICE_TIMEOUT: seconds before rack-timeout aborts a request (default 15)
# RACK_TIMEOUT_SERVICE_TIMEOUT=15
# MALLOC_ARENA_MAX: caps glibc malloc arenas to curb Puma memory growth
# MALLOC_ARENA_MAX=2
# SCOUT_KEY / SCOUT_MONITOR: Scout APM; monitoring stays off unless SCOUT_MONITOR=true
# SCOUT_KEY=
# SCOUT_MONITOR=true
# SCOUT_LOG_LEVEL=WARN
# HIREFIRE_TOKEN: HireFire worker autoscaling on Delayed Job queue size
# HIREFIRE_TOKEN=

# Maintenance and debugging
# OLD_SECRET_KEY_BASE: the other release's secret for `bin/rails rich_text:*`
# when it differs from this one's; pass it on the command line rather than here
# BACKTRACE: any value shows framework lines in backtraces
# BACKTRACE=1
# NO_COVERAGE: any value skips SimpleCov in specs
# NO_COVERAGE=1
